<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>State-wise Sports Tournaments</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <h1>🏆 Sports Tournament Hub</h1>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="hero">
            <h1>Find & Register for Tournaments</h1>
            <p>State-wise sports competitions across India</p>
        </div>

        <div class="states-grid">
            <h2>Select Your State</h2>
            <div class="state-cards">
                <% states.forEach(state => { %>
                <div class="state-card">
                    <h3><%= state %></h3>
                    <a href="/tournaments/<%= encodeURIComponent(state) %>" class="btn">View Tournaments</a>
                </div>
                <% }); %>
            </div>
        </div>
    </div>

    <footer class="footer">
        <div class="container">
            <p>&copy; 2024 Sports Tournament Hub. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>
